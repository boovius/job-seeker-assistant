# API
API_PORT=8000
API_ENV=development
API_LOCAL_DEBUG=false
API_LOCAL_DEBUG_USER_ID=local-debug-user

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/job_culler

# Supabase Auth
SUPABASE_PROJECT_REF=your_project_ref
# Supabase base URL (from project settings)
SUPABASE_URL=https://your_project_ref.supabase.co
# Supabase public anon key (for client auth / JWT fetch script)
SUPABASE_ANON_KEY=your_anon_key
# Optional JWKS URL override (defaults to SUPABASE_URL/auth/v1/keys)
SUPABASE_JWKS_URL=
SUPABASE_USER_ID=replace_with_supabase_user_id_for_seeding

# Web
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Automated Discovery
SOURCES_CONFIG=config/sources.yaml
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOOBLE_API_KEY=your_jooble_api_key
WORKER_POLL_SECONDS=5

# LLM Query Generation (OpenAI)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
