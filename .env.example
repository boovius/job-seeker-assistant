# API
API_PORT=8000
API_ENV=development

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/job_culler

# Supabase Auth
SUPABASE_PROJECT_REF=your_project_ref
# Supabase public anon key (for client auth / JWT fetch script)
SUPABASE_ANON_KEY=your_anon_key
# Legacy HS256 secret (only if JWKS not available)
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret
SUPABASE_USER_ID=replace_with_supabase_user_id_for_seeding

# Web
VITE_API_BASE_URL=http://localhost:8000

# Automated Discovery
GREENHOUSE_BOARD_TOKENS=comma,separated,board_tokens
LEVER_COMPANIES=comma,separated,company_names
REMOTIVE_KEYWORDS=comma,separated,keywords
REMOTIVE_CATEGORIES=comma,separated,categories
WORKER_POLL_SECONDS=5
