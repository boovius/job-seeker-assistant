 ## Local Dev (API)
 ```bash
 cd apps/api
 python -m venv .venv
 source .venv/bin/activate
 pip install -r requirements.txt
 
 # Ensure env vars (see .env.example)
 export $(cat ../../.env | xargs)
 
 # Run API
 PYTHONPATH=../../packages uvicorn app.main:app --reload --port 8000
